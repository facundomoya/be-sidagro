NODE_ENV=development

PORT=3005

DB_HOST=
DB_PORT=
DB_USER=
DB_PASS=
DB_DATABASE=
DB_DIALECT=

JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=360000s

# --- ALMACENAMIENTO (STORAGE) ---
# Define el motor: fs o sftp
STORAGE_TYPE=fs

# Ruta absoluta donde se guardan los archivos - Puede ser local o en el servidor
STORAGE_BASE_PATH=

# --- CREDENCIALES SFTP ---
# Solo se usan si STORAGE_TYPE=sftp
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
