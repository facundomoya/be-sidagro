NODE_ENV=development

PORT=3005

DB_HOST=
DB_PORT=
DB_USER=
DB_PASS=
DB_DATABASE=
DB_DIALECT=

JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=360000s

# --- ALMACENAMIENTO (STORAGE) ---
# Define el motor: fs o sftp
STORAGE_TYPE=fs

# Ruta absoluta donde se guardan los archivos - Puede ser local o en el servidor
STORAGE_BASE_PATH=

# --- CREDENCIALES SFTP ---
# Solo se usan si STORAGE_TYPE=sftp
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=

# --- CLIMA (Open-Meteo, sin API key) ---
# Opcionales: por defecto https://api.open-meteo.com/v1/forecast y 8000 ms
OPEN_METEO_URL=
OPEN_METEO_HISTORICO_URL=
OPEN_METEO_TIMEOUT_MS=

# --- PRECIO DE LA SOJA (pizarra de la Bolsa de Comercio de Rosario, sin API key) ---
# Opcionales: por defecto https://www.cac.bcr.com.ar/es/precios-de-pizarra y 8000 ms
PRECIO_SOJA_URL=
PRECIO_SOJA_TIMEOUT_MS=

# --- IA (recomendación agronómica) ---
# reglas (por defecto, sin IA) o mistral
IA_PROVEEDOR=reglas
# Solo si IA_PROVEEDOR=mistral. La clave se crea en https://console.mistral.ai
MISTRAL_API_KEY=
# Opcionales: por defecto mistral-large-latest, 60000 ms e ia-documentos/indice.json
MISTRAL_MODEL=
MISTRAL_TIMEOUT_MS=
IA_INDICE_PATH=
