NODE_ENV=development

PORT=3005

DB_HOST=
DB_PORT=
DB_USER=
DB_PASS=
DB_DATABASE=
DB_DIALECT=

JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=360000s

# --- ALMACENAMIENTO (STORAGE) ---
# Define el motor: fs o sftp
STORAGE_TYPE=fs

# Ruta absoluta donde se guardan los archivos - Puede ser local o en el servidor
STORAGE_BASE_PATH=

# --- CREDENCIALES SFTP ---
# Solo se usan si STORAGE_TYPE=sftp
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=

# --- CLIMA (Open-Meteo, sin API key) ---
# Opcionales: por defecto https://api.open-meteo.com/v1/forecast y 8000 ms
OPEN_METEO_URL=
OPEN_METEO_TIMEOUT_MS=

# --- IA (recomendación agronómica) ---
# reglas (por defecto, sin IA) o gemini
IA_PROVEEDOR=reglas
# Solo si IA_PROVEEDOR=gemini. La clave se crea en https://aistudio.google.com
GEMINI_API_KEY=
# Lo imprime "npm run ia:indexar" (ej: fileSearchStores/sid-agro-xxxx)
GEMINI_FILE_SEARCH_STORE=
# Opcionales: por defecto gemini-3.8-flash y 60000 ms
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=
